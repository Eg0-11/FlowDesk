<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowdesk</groupId>
    <artifactId>flowdesk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowdesk-agent</artifactId>
  <name>flowdesk-agent</name>
  <description>AI 编排层：实现 application 的 AI 用例，使用 ChatClient 编排提示词与本地工具</description>

  <dependencies>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-application</artifactId>
    </dependency>

    <!-- ChatClient 与 @Tool / ToolContext 所在制品；版本由 spring-ai-bom 管理 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>

    <!-- 仅用于 @ConditionalOnProperty / @Configuration，使 AI 服务受 flowdesk.ai.enabled 控制 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- 日志门面：工具与编排需要记录 requestId/工具名/结果/耗时（版本由 spring-boot-dependencies 管理） -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!--
      提示词的结构化数据序列化（FD-0012-R1）：问答提示词把问题与证据序列化成确定性 JSON，
      所以这里显式声明 Jackson，而不是依赖 Spring AI 偶然带进来的传递依赖。
      版本由 spring-boot-dependencies 管理，不在此声明版本。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
