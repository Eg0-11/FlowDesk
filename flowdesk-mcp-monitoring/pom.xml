<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowdesk</groupId>
    <artifactId>flowdesk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowdesk-mcp-monitoring</artifactId>
  <name>flowdesk-mcp-monitoring</name>
  <description>独立监控 MCP 服务：只依赖 flowdesk-shared，与主服务进程隔离</description>

  <dependencies>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-shared</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      MCP Server（WebMVC / Streamable HTTP）：FD-0015，与资产 MCP 服务同一条已验收基线。
      版本由根 pom 导入的 spring-ai-bom（1.1.2）管理，此处不写版本 —— 与本仓库其它 Spring AI
      依赖保持同一条版本基线，不单独升级 Spring AI / Spring Boot。
      用 WebMVC 变体而不是 WebFlux：本模块本来就是 Servlet 栈（spring-boot-starter-web），
      引入 WebFlux 会同时存在两套 Web 运行时。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
