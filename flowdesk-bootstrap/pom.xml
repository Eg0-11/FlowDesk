<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowdesk</groupId>
    <artifactId>flowdesk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowdesk-bootstrap</artifactId>
  <name>flowdesk-bootstrap</name>
  <description>FlowDesk 主服务启动模块：装配 agent 与 infrastructure，暴露 HTTP 接口</description>

  <dependencies>
    <!--
      Controller 直接依赖 com.flowdesk.application.ai 下的用例接口与命令/结果对象，
      因此这里必须显式声明 application 模块，不能靠 agent 的传递依赖。
      版本由根 pom 的 dependencyManagement 管理。
    -->
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-application</artifactId>
    </dependency>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-agent</artifactId>
    </dependency>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-infrastructure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      默认 profile 使用内存 H2（PostgreSQL 兼容模式）运行，无需数据库密码即可启动。
      H2 只服务本地开发与自动化测试，生产使用 postgres profile 连接 PostgreSQL。
      版本由 spring-boot-dependencies 管理。
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
