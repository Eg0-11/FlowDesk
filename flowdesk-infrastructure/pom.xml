<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowdesk</groupId>
    <artifactId>flowdesk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowdesk-infrastructure</artifactId>
  <name>flowdesk-infrastructure</name>
  <description>基础设施层：持久化、模型等外部系统适配器（Spring JDBC 工单存储、DeepSeek 传输适配）</description>

  <dependencies>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-application</artifactId>
    </dependency>

    <!--
      DeepSeek 走 OpenAI 兼容的 Chat Completions 传输，因此使用 OpenAI 适配器而非原生 DeepSeek 适配器。
      决策与理由见 docs/adr/0001-deepseek-openai-compatible-transport.md。
      版本由 spring-ai-bom 管理，此处不写版本。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!-- 工单持久化：显式 SQL + JdbcClient，不使用 JPA。决策理由见 docs/adr/0002。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 仅用于本地运行与自动化集成测试，不是生产数据库。 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      文档解析（FD-0009）：Apache Tika 3.x。

      版本由父 POM 的 ${tika.version} 统一锁定，子模块不写版本。
      - tika-core：Tika 门面与元数据 API；
      - tika-parsers-standard-package：标准解析器包（PDF 走 PDFBox、DOCX 走 POI）。
      刻意不使用 tika-app：那是给命令行用的胖 jar，会带入大量无关依赖。
    -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parsers-standard-package</artifactId>
    </dependency>
  </dependencies>
</project>
