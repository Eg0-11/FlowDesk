<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowdesk</groupId>
    <artifactId>flowdesk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowdesk-infrastructure</artifactId>
  <name>flowdesk-infrastructure</name>
  <description>基础设施层：持久化、模型等外部系统适配器（Spring JDBC 工单存储、DeepSeek 传输适配）</description>

  <dependencies>
    <dependency>
      <groupId>com.flowdesk</groupId>
      <artifactId>flowdesk-application</artifactId>
    </dependency>

    <!--
      DeepSeek 走 OpenAI 兼容的 Chat Completions 传输，因此使用 OpenAI 适配器而非原生 DeepSeek 适配器。
      决策与理由见 docs/adr/0001-deepseek-openai-compatible-transport.md。
      版本由 spring-ai-bom 管理，此处不写版本。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!--
      文档切片 Embedding（FD-0010）：DashScope（阿里云百炼）text-embedding-v4。

      决策与理由见 docs/adr/0007-dashscope-embedding-pgvector-storage.md：
      DeepSeek 只负责 Chat/Agent，Embedding 由 DashScope 提供；两者各自使用自己的 starter，
      互不替换。版本由 spring-ai-alibaba-bom 管理，此处不写版本。

      该 starter 只在 dashscope-embedding profile 下真正生效：默认配置里
      spring.ai.model.embedding=none，不会创建 EmbeddingModel，也不会发生任何网络请求。
    -->
    <dependency>
      <groupId>com.alibaba.cloud.ai</groupId>
      <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
    </dependency>

    <!-- 工单持久化：显式 SQL + JdbcClient，不使用 JPA。决策理由见 docs/adr/0002。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      文本重排（FD-0013）的请求/响应序列化：qwen3-rerank 的扁平 HTTP 协议用 Jackson 读写 JSON。
      这里显式声明直接依赖，而不是依赖其它 starter 偶然带进来的传递依赖。
      版本由 spring-boot-dependencies 管理，此处不写版本。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 仅用于本地运行与自动化集成测试，不是生产数据库。 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      PostgreSQL + pgvector 集成测试（FD-0010）。

      vector(1024) 列与 HNSW 索引只在真实 PostgreSQL 上存在，因此这部分验证必须跑真库。
      镜像固定为 pgvector 官方镜像的具体版本（不使用 latest）；没有 Docker 时
      @Testcontainers(disabledWithoutDocker = true) 会让该测试跳过，
      交付报告如实标注 POSTGRESQL_PGVECTOR_IT=NOT_RUN。
      版本由 spring-boot-starter-parent 的 BOM 管理，子模块不写版本。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      文档解析（FD-0009）：Apache Tika 3.x。

      版本由父 POM 的 ${tika.version} 统一锁定，子模块不写版本。
      - tika-core：Tika 门面与元数据 API；
      - tika-parsers-standard-package：标准解析器包（PDF 走 PDFBox、DOCX 走 POI）。
      刻意不使用 tika-app：那是给命令行用的胖 jar，会带入大量无关依赖。

      日志依赖排除（FD-0009-R1）：Tika 会连带引入两份 JCL 实现 ——
      commons-logging 与 jcl-over-slf4j；它们与 Spring 自带的 spring-jcl 都提供
      org/apache/commons/logging/LogFactory.class，最终由类加载顺序随机决定用哪一份。
      这里把前两个排除掉，只保留 spring-jcl（它自己就转发到 SLF4J），
      于是 SLF4J 的唯一 provider 仍是 Logback，不存在第二套日志后端。
    -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-parsers-standard-package</artifactId>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>jcl-over-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      MCP 客户端（FD-0016）：主服务按次调用两个独立 MCP 服务的固定工具。
      这里声明的是 Spring AI 的 MCP 集成构件（版本由 spring-ai-bom 管理，此处不写版本）：
      它传递进来的正是官方 MCP Java SDK 的聚合构件 mcp（0.17.0，随附 mcp-core / mcp-json /
      mcp-json-jackson2），与两个 MCP 服务用的是同一个版本 —— 因此 MCP SDK 的版本只有
      「Spring AI 版本」这一个来源，不存在两处各写一份、互相漂移的可能。
      它自带的 mcp-spring-webflux / mcp-spring-webmvc 是 optional，不会传递进来，
      所以主服务不会因此多出一套 Web 运行时，也不会内嵌任何 MCP Server。
      代码只用 SDK 的客户端与 Streamable HTTP 传输（只读查询），不加连接池、不做后台重连。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-mcp</artifactId>
    </dependency>
  </dependencies>
</project>
