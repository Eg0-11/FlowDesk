# FlowDesk 环境变量示例
#
# 重要：Spring Boot 不会自动读取 .env 文件。
# 本文件只是「需要哪些变量」的清单，必须由 Shell、IDE 运行配置或容器编排显式注入。
#
# 推荐启动方式（先打包再运行 jar，干净仓库也能直接跑通）：
#   $env:DEEPSEEK_API_KEY = '<your-key>'
#   .\mvnw.cmd clean package
#   java -jar flowdesk-bootstrap/target/flowdesk-bootstrap-0.1.0-SNAPSHOT.jar --spring.profiles.active=deepseek
#
# 备选方式（单模块 spring-boot:run 必须先 install，否则兄弟模块解析不到）：
#   $env:DEEPSEEK_API_KEY = '<your-key>'
#   .\mvnw.cmd -DskipTests clean install
#   .\mvnw.cmd -pl flowdesk-bootstrap spring-boot:run "-Dspring-boot.run.profiles=deepseek"
#
# PowerShell 下 -D 参数的写法：
#   -D 参数的「值」里只要含有点号或等号，就必须用引号包住，否则 PowerShell 会把它拆开。
#   反例（已实测失败）：-Dspring-boot.run.profiles=deepseek
#     → 被拆成 .run.profiles=deepseek，Maven 报 Unknown lifecycle phase
#   正例：              "-Dspring-boot.run.profiles=deepseek"
#   -DskipTests 这类不含点号与等号的参数，加不加引号都可以。
#
# 也不要把 -am 与 spring-boot:run 一起用：该 goal 会在没有主类的库模块上执行并失败。
#
# 永远不要提交真实 Key：本文件只保留空值占位。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
